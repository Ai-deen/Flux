# Flux - Environment Configuration
# Copy this to .env and fill in your values
# Run: cp .env.example .env

# ─── Jira Cloud ───────────────────────────────────────────────────────────
# Get token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_DOMAIN=your-team.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_BOARD_ID=1

# ─── Slack ────────────────────────────────────────────────────────────────
# Create app: https://api.slack.com/apps → OAuth & Permissions
# Required scopes: channels:manage, channels:read, channels:history,
#                  chat:write, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# ─── Azure Storage ────────────────────────────────────────────────────────
# Auto-created by: python scripts/setup_azure.py
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=flux

# ─── Azure AI Search ─────────────────────────────────────────────────────
# Auto-created by: python scripts/setup_azure.py
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=flux-commits

# ─── LLM — Groq (Primary) ─────────────────────────────────────────────
# Get free API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key

# ─── LLM — Fallback (Optional) ───────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ─── Repo Path ────────────────────────────────────────────────────────────
FLUX_REPO_PATH=/path/to/your/project
